# === EB Motion – Stripe Checkout Server ===
# Diese Datei nach ".env" kopieren und ausfüllen. Die echte .env wird NICHT
# committet (siehe .gitignore).

# PFLICHT: Geheimer Stripe-Schlüssel – NUR hier auf dem Server, nie im Frontend!
# Stripe-Dashboard -> Entwickler -> API-Schlüssel. Testmodus beginnt mit sk_test_…
STRIPE_SECRET_KEY=sk_test_DEIN_GEHEIMER_SCHLUESSEL

# OPTIONAL: Fertige Price-ID aus dem Stripe-Dashboard (Produkt -> Preis).
# Wenn gesetzt, wird sie verwendet. Wenn leer, baut der Server den Preis aus den
# PRICE_*-Werten unten – praktisch zum Testen ganz ohne Dashboard-Produkt.
STRIPE_PRICE_ID=

# Preis-Definition (nur relevant, wenn STRIPE_PRICE_ID leer ist):
PRICE_AMOUNT=12900            # in Cent  ->  12900 = 129,00 €
PRICE_CURRENCY=eur
PRICE_INTERVAL=month          # day | week | month | year
PRODUCT_NAME=EB Motion – Website-Abo

# OPTIONAL: Webhook-Signatur-Geheimnis für /webhook (Dashboard oder Stripe-CLI
# "stripe listen"). Ohne diesen Wert werden Webhooks ungeprüft verarbeitet –
# für die Produktion unbedingt setzen.
STRIPE_WEBHOOK_SECRET=

# Erlaubte Frontend-Adressen (kommagetrennt). Für die Produktion deine echte
# Domain ergänzen, z. B. https://ebmotion.de
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Port des Servers
PORT=4242
