# Frontend-Konfiguration (Vite). Zum Überschreiben der Standardwerte diese Datei
# nach ".env" (oder ".env.local") kopieren. Werte sind öffentlich – KEINE
# Geheimnisse hier ablegen (der geheime Stripe-Schlüssel gehört in server/.env).

# Öffentlicher (publishable) Stripe-Schlüssel. Für Live-Betrieb pk_live_… nutzen.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_DEIN_PUBLISHABLE_KEY

# Adresse des Checkout-Servers (Ordner server/). Für die Produktion anpassen.
VITE_PAYMENTS_API=http://localhost:4242
